<%- include('partials/head', { titulo }) %>

<main>

  <!-- HERO -->
  <section
    class="flex flex-col items-center gap-10 py-12 text-center lg:flex-row lg:justify-between lg:py-16 lg:text-left"
    aria-labelledby="hero-heading"
  >
    <div class="w-full lg:w-1/2">
      <span class="mb-4 inline-flex items-center gap-2 rounded-full bg-[#fff0f0] px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-[#d90429]">
        Primeiros socorros
      </span>

      <h1
        id="hero-heading"
        class="text-[42px] font-bold leading-[1.08] text-[#222] max-md:text-[34px] max-[480px]:text-[28px]"
      >
        Aprenda primeiros socorros
      </h1>

      <p class="mx-auto mt-5 max-w-[520px] text-lg leading-relaxed text-[#555] lg:mx-0 max-md:text-base">
        Informações acessíveis sobre como agir em situações de emergência —
        passo a passo, recursos visuais e consulta rápida.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row lg:justify-start">
        <a
          href="#emergencias"
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#ff4d4d] px-6 py-3.5 text-base font-semibold text-white no-underline shadow-[0_10px_20px_rgba(255,77,77,0.22)] transition-all hover:-translate-y-0.5 hover:bg-[#e63e3e] hover:shadow-[0_14px_26px_rgba(255,77,77,0.28)] sm:w-auto"
        >
          Ver emergências
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/aulas"
          class="inline-flex w-full items-center justify-center rounded-xl border border-[#eee] bg-white px-6 py-3.5 text-base font-semibold text-[#333] no-underline transition-colors hover:border-[#ffd6d6] hover:bg-[#fff7f7] hover:text-[#d90429] sm:w-auto"
        >
          Acessar aulas
        </a>
      </div>
    </div>

    <div class="flex w-full justify-center lg:w-1/2">
      <div
        class="relative w-[520px] max-w-full overflow-hidden rounded-[2rem] rounded-tr-none border border-[#ececec] bg-white shadow-[0_24px_60px_rgba(0,0,0,0.10)] lg:w-[560px]"
      >
        <img
          src="/images/imagemrcp.png"
          alt="Pessoa realizando RCP"
          class="block h-auto w-full"
        >
      </div>
    </div>
  </section>


  <!-- EMERGÊNCIAS -->
  <section id="emergencias" class="border-t border-[#eee] py-14 max-md:py-10">

    <div class="mx-auto mb-10 max-w-2xl text-center">
      <span class="mb-3 inline-block rounded-full bg-[#fff0f0] px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-[#d90429]">
        Consulta rápida
      </span>
      <h2 class="text-[34px] font-bold leading-tight text-[#222] max-md:text-[26px]">
        Emergências em Destaque
      </h2>
      <p class="mx-auto mt-3 max-w-[560px] text-base leading-relaxed text-[#666]">
        Encontre rapidamente a orientação que você precisa.
      </p>
    </div>

    <!-- FILTROS -->
    <div class="mx-auto mb-6 flex w-full max-w-3xl flex-col gap-3 sm:flex-row">

      <div class="relative flex-1">
        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-lg text-[#999]">
          🔎
        </span>
        <input
          id="buscaEmergencia"
          type="text"
          placeholder="Pesquisar emergência..."
          aria-label="Pesquisar emergência"
          class="w-full rounded-xl border border-[#ddd] bg-white py-3 pl-11 pr-4 text-[15px] text-[#222] outline-none transition focus:border-[#ff4d4d] focus:ring-2 focus:ring-[#ff4d4d]/15"
        >
      </div>

      <div class="sm:w-[230px]">
        <select
          id="filtroCategoria"
          aria-label="Filtrar por categoria"
          class="w-full cursor-pointer rounded-xl border border-[#ddd] bg-white px-4 py-3 text-[15px] text-[#222] outline-none transition focus:border-[#ff4d4d] focus:ring-2 focus:ring-[#ff4d4d]/15"
        >
          <option value="todas">Todas as categorias</option>
          <option value="Ferimentos">Ferimentos</option>
          <option value="Respiração">Respiração</option>
          <option value="Traumas">Traumas</option>
          <option value="Outros">Outros</option>
        </select>
      </div>

    </div>

    <!-- CONTADOR -->
    <p
      id="contadorEmergencias"
      class="mb-6 text-center text-sm font-medium text-[#777]"
      aria-live="polite"
    >
      Mostrando emergências
    </p>

    <!-- CARDS -->
    <div
      id="listaEmergencias"
      class="grid auto-rows-fr grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6"
    >
      <% emergencias.forEach((e) => { %>
      <a
        href="<%= e.rota %>"
        class="card-emergencia group flex h-full flex-col items-center rounded-2xl border border-[#eee] bg-white p-6 text-center shadow-[0_2px_10px_rgba(0,0,0,0.03)] transition-all duration-300 hover:-translate-y-1.5 hover:border-[#ffd6d6] hover:shadow-[0_18px_35px_rgba(255,77,77,0.12)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ff4d4d]/40"
        data-nome="<%= e.nome.toLowerCase() %>"
        data-categoria="<%= e.categoria %>"
      >
        <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#fff5f5] ring-1 ring-[#ffe3e3] transition-colors group-hover:bg-[#fff0f0]">
          <img
            src="<%= e.icone %>"
            alt=""
            loading="lazy"
            class="h-9 w-9 object-contain"
          >
        </span>

        <div class="mt-4 flex flex-1 flex-col items-center">
          <h3 class="text-[18px] font-bold leading-snug text-[#222]">
            <%= e.nome %>
          </h3>

          <span class="mt-3 inline-flex items-center rounded-full bg-[#fff0f0] px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-[#d90429]">
            <%= e.categoria %>
          </span>
        </div>

        <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-[#ff4d4d]">
          Ver mais
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </a>
      <% }); %>

      <!-- NENHUM RESULTADO -->
      <div
        id="semResultado"
        class="hidden col-span-full rounded-2xl border border-dashed border-[#eee] bg-white/60 px-6 py-14 text-center"
      >
        <div class="mb-3 text-4xl">🔎</div>
        <h3 class="mb-2 text-xl font-semibold text-[#222]">Nenhuma emergência encontrada</h3>
        <p class="text-[#777]">Tente pesquisar por outro termo ou alterar a categoria.</p>
      </div>

    </div>

  </section>


  <!-- COMO FUNCIONA -->
  <section id="como-funciona" class="border-t border-[#eee] pt-16 pb-8 max-md:pt-12">

    <div class="mx-auto mb-12 max-w-[720px] text-center">
      <span class="mb-3 inline-block rounded-full bg-[#fff0f0] px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-[#d90429]">
        Passo a passo
      </span>
      <h2 class="text-[34px] font-bold leading-tight text-[#222] max-md:text-[26px]">
        Como funciona?
      </h2>
      <p class="mx-auto mt-3 max-w-[620px] text-base leading-relaxed text-[#666]">
        Encontre informações de primeiros socorros de forma rápida, simples e
        organizada para saber como agir diante de diferentes situações de emergência.
      </p>
    </div>

    <div class="grid auto-rows-fr gap-6 lg:grid-cols-3">

      <!-- ETAPA 1 -->
      <div class="flex h-full flex-col rounded-2xl border border-[#eee] bg-white p-7 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_35px_rgba(0,0,0,0.07)]">
        <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-[#fff0f0] text-xl font-bold text-[#ff4d4d]">
          1
        </div>
        <h3 class="mb-3 text-[20px] font-semibold text-[#222]">Escolha a emergência</h3>
        <p class="mb-6 flex-1 leading-relaxed text-[#666]">
          Encontre rapidamente a situação que está acontecendo, como uma
          convulsão, parada cardiorrespiratória ou outro tipo de emergência.
        </p>
        <div class="text-sm text-[#888]">
          <span class="font-medium text-[#555]">Consulta rápida</span><br>
          Encontre a orientação em poucos segundos.
        </div>
      </div>

      <!-- ETAPA 2 -->
      <div class="flex h-full flex-col rounded-2xl border border-[#eee] bg-white p-7 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_35px_rgba(0,0,0,0.07)]">
        <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-[#fff0f0] text-xl font-bold text-[#ff4d4d]">
          2
        </div>
        <h3 class="mb-3 text-[20px] font-semibold text-[#222]">Siga o passo a passo</h3>
        <p class="mb-6 flex-1 leading-relaxed text-[#666]">
          Veja instruções organizadas de forma clara, acompanhadas de recursos
          visuais para facilitar a compreensão de cada procedimento.
        </p>
        <div class="text-sm text-[#888]">
          <span class="font-medium text-[#555]">Orientação simples</span><br>
          Informações diretas e fáceis de acompanhar.
        </div>
      </div>

      <!-- ETAPA 3 -->
      <div class="flex h-full flex-col rounded-2xl border border-[#eee] bg-white p-7 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_35px_rgba(0,0,0,0.07)]">
        <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-[#fff0f0] text-xl font-bold text-[#ff4d4d]">
          3
        </div>
        <h3 class="mb-3 text-[20px] font-semibold text-[#222]">Aja com segurança</h3>
        <p class="mb-6 flex-1 leading-relaxed text-[#666]">
          Utilize as informações para agir de maneira mais segura enquanto
          aguarda, quando necessário, a chegada do atendimento especializado.
        </p>
        <div class="text-sm text-[#888]">
          <span class="font-medium text-[#555]">Priorize a segurança</span><br>
          Em situações graves, procure ajuda profissional.
        </div>
      </div>

    </div>

    <div class="mt-8 flex flex-col items-center gap-4 rounded-2xl border border-[#ffe1e1] bg-[#fff7f7] px-7 py-5 text-center sm:flex-row sm:text-left">
      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#ff4d4d] text-xl font-bold text-white">
        !
      </div>
      <div>
        <h3 class="mb-1 text-[17px] font-semibold text-[#222]">Importante</h3>
        <p class="text-sm leading-relaxed text-[#666]">
          O Fast Aid é uma plataforma de orientação e educação em primeiros
          socorros. Em situações graves ou que ofereçam risco à vida, acione
          o serviço de emergência rapidamente se necessário.
        </p>
      </div>
    </div>

  </section>

</main>


<%- include('partials/footer') %>
<%- include('partials/foot') %>


<!-- FILTRO -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const busca = document.getElementById("buscaEmergencia");
    const categoria = document.getElementById("filtroCategoria");
    const cards = document.querySelectorAll(".card-emergencia");
    const semResultado = document.getElementById("semResultado");
    const contador = document.getElementById("contadorEmergencias");

    function filtrarEmergencias() {
      const texto = busca.value.toLowerCase().trim();
      const categoriaSelecionada = categoria.value;

      let encontrados = 0;

      cards.forEach(function (card) {
        const nome = (card.dataset.nome || "").toLowerCase();
        const categoriaCard = card.dataset.categoria || "";

        const correspondeNome = nome.includes(texto);
        const correspondeCategoria =
          categoriaSelecionada === "todas" || categoriaCard === categoriaSelecionada;

        const mostrar = correspondeNome && correspondeCategoria;

        if (mostrar) {
          card.style.display = "";
          encontrados++;
        } else {
          card.style.display = "none";
        }
      });

      semResultado.style.display = encontrados === 0 ? "block" : "none";

      if (encontrados === 1) {
        contador.textContent = "1 emergência encontrada";
      } else {
        contador.textContent = encontrados + " emergências encontradas";
      }
    }

    busca.addEventListener("input", filtrarEmergencias);
    categoria.addEventListener("change", filtrarEmergencias);

    filtrarEmergencias();
  });
</script>
