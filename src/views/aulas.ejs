<%- include('partials/head', { titulo }) %>

    <main class="max-w-[1200px] mx-auto py-12 px-4 max-md:py-8">

      <div class="text-center mb-10 max-md:mb-8">
        <span class="inline-block bg-[#fff0f0] text-[#d90429] text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full mb-3">
          Área do Aluno
        </span>
        <h1 class="text-[38px] font-bold text-[#222] mb-3 max-md:text-[28px]">Aulas</h1>
        <p class="text-[#555] max-w-[640px] mx-auto text-base">
          Olá, <strong><%= usuario.nome %></strong>! Escolha uma aula para revisar os procedimentos de primeiros socorros.
        </p>
      </div>

      <div class="grid grid-cols-3 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1">

        <% aulas.forEach((aula) => { %>
        <article class="bg-white rounded-[16px] p-6 border border-[#eee] shadow-[0_4px_15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] transition-all flex flex-col justify-between">

          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="inline-block text-xs bg-[#fff0f0] text-[#d90429] px-2.5 py-1 rounded-full font-semibold">
                <%= aula.nivel %>
              </span>
              <span class="text-xs text-[#888] font-medium">⏱ <%= aula.duracao %></span>
            </div>

            <h2 class="text-[21px] font-bold text-[#222] mb-2 leading-tight">
              <%= aula.titulo %>
            </h2>

            <p class="text-[#666] text-sm leading-relaxed mb-6">
              <%= aula.descricao %>
            </p>
          </div>

          <a href="<%= aula.rota %>" class="inline-flex items-center justify-center gap-1.5 bg-[#ff4d4d] hover:bg-[#e63e3e] text-white font-bold py-2.5 px-4 rounded-lg no-underline text-sm transition-colors">
            Abrir aula →
          </a>

        </article>
        <% }); %>

      </div>

    </main>

<%- include('partials/footer') %>
<%- include('partials/foot') %>
