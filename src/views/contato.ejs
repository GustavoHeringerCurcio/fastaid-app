<%- include('partials/head', { titulo }) %>

    <main class="max-w-[1100px] mx-auto py-12 px-4 max-md:py-8">

      <!-- Cabeçalho da Seção -->
      <div class="text-center mb-12 max-md:mb-8">
        <span class="inline-block bg-[#fff0f0] text-[#d90429] text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full mb-3">
          Nossa Equipe
        </span>
        <h1 class="text-[36px] font-bold text-[#222] mb-3 max-md:text-[28px]">Entre em Contato</h1>
        <p class="text-[#555] max-w-[600px] mx-auto text-base">
          Conheça os integrantes responsáveis pelo desenvolvimento do projeto <strong>Fast Aid</strong>. Utilize os canais abaixo para dúvidas, sugestões ou parcerias.
        </p>
      </div>

      <!-- GRADE DE INTEGRANTES -->
      <div class="grid grid-cols-3 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1 justify-items-center">

        <article class="w-full max-w-[360px] bg-white rounded-[16px] p-6 border border-[#eee] shadow-[0_4px_15px_rgba(0,0,0,0.05)] hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(0,0,0,0.1)] transition-all flex flex-col justify-between">

