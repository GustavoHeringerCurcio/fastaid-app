              <div>
                <h2 class="text-xl font-bold text-[#222] leading-tight">Nome do Integrante</h2>
                <span class="text-sm text-[#ff4d4d] font-semibold">Função / Cargo no Grupo</span>
              </div>
            </div>

            <div class="flex flex-col gap-3 text-sm text-[#444] mb-6">
              <a href="https://wa.me/5500900000000" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-2.5 rounded-lg bg-[#f8f9fa] hover:bg-[#fff0f0] text-[#333] hover:text-[#d90429] no-underline transition-colors">
                <svg class="w-5 h-5 text-[#ff4d4d] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
