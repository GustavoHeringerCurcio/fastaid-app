<%- include('partials/head', { titulo }) %>

    <div class="text-center mt-[25px] mb-[10px] flex justify-center items-center">
      <img src="<%= conteudo.icone %>" class="w-[120px] m-[30px] -mb-5 max-md:w-[95px] max-md:m-[22px] max-md:-mb-[10px]" alt="<%= conteudo.titulo %>">
    </div>

    <section class="max-w-[900px] mx-auto py-10 px-5 text-center max-md:py-[30px] max-md:px-3">
      <h1 class="text-[32px] mb-[10px] max-lg:text-[27px] max-md:text-2xl font-bold"><%= conteudo.titulo %></h1>
      <p class="text-base mb-[25px] text-[#555] max-md:text-[15px]">Siga o passo a passo abaixo:</p>

      <% if (conteudo.alerta) { %>
      <div class="bg-[#f8f9fa] border-l-4 border-[#d90429] p-4 mb-7 rounded-lg shadow-sm flex flex-wrap items-center justify-between gap-4 text-left max-md:flex-col max-md:text-center">
        <div class="flex-1 min-w-[240px]">
          <strong class="text-sm uppercase tracking-wider text-[#d90429] block">⚠️ Regra de Ouro / O que NÃO fazer:</strong>
          <p class="text-sm text-[#333] font-medium mt-1"><%= conteudo.alerta %></p>
        </div>
        <div class="flex gap-2 flex-wrap justify-center">
          <button onclick="lerInstrucoesPagina('#passos-<%= conteudo.id %>', this)" class="bg-[#2b2d42] hover:bg-[#1e2030] text-white border-none py-2.5 px-4 rounded-lg text-sm font-bold cursor-pointer transition-colors">
            🔊 Ouvir Instruções
          </button>
        </div>
      </div>
      <% } %>

      <% if (conteudo.id === 'rcp') { %>
      <div class="bg-[#f8f9fa] border-l-4 border-[#d90429] p-4 mb-7 rounded-lg shadow-sm flex flex-wrap items-center justify-between gap-4 text-left max-md:flex-col max-md:text-center">
        <div>
          <strong class="text-lg text-[#222]">Suporte de Ritmo e Voz (Mãos Livres)</strong>
          <p class="text-sm text-[#555] mt-1">Comprima o centro do peito forte e rápido seguindo o bip sonoro.</p>
        </div>
        <div class="flex gap-2.5 flex-wrap justify-center">
          <button onclick="alternarMetronomoRCP(this)" class="bg-[#d90429] hover:bg-[#b80322] text-white border-none py-2.5 px-4 rounded-lg text-sm font-bold cursor-pointer transition-transform">
            🥁 Iniciar Ritmo (110 BPM)
          </button>
          <button onclick="lerInstrucoesPagina('#passos-rcp', this)" class="bg-[#2b2d42] hover:bg-[#1e2030] text-white border-none py-2.5 px-4 rounded-lg text-sm font-bold cursor-pointer transition-colors">
            🔊 Ouvir Instruções
          </button>
        </div>
      </div>
      <% } %>

      <% if (conteudo.id === 'convulsao') { %>
      <div class="bg-[#f8f9fa] border-l-4 border-[#d90429] p-4 mb-7 rounded-lg shadow-sm flex flex-wrap items-center justify-between gap-4 text-left max-md:flex-col max-md:text-center">
        <div>
          <strong class="text-sm uppercase tracking-wider text-[#555] block">Tempo de Duração da Crise:</strong>
          <div id="tempo-crise" class="text-3xl font-mono font-extrabold text-[#2b2d42] mt-0.5">00:00</div>
        </div>
        <div class="flex gap-2 flex-wrap justify-center">
          <button id="btn-cronometro" onclick="alternarCronometroConvulsao(this, document.getElementById('tempo-crise'))" class="bg-[#d90429] hover:bg-[#b80322] text-white border-none py-2.5 px-4 rounded-lg text-sm font-bold cursor-pointer transition-colors">
            ⏱️ Iniciar Cronômetro
          </button>
          <button onclick="zerarCronometroConvulsao(document.getElementById('btn-cronometro'), document.getElementById('tempo-crise'))" class="bg-[#6c757d] hover:bg-[#5a6268] text-white border-none py-2.5 px-3.5 rounded-lg text-sm font-bold cursor-pointer transition-colors">
            🔄 Zerar
          </button>
          <button onclick="lerInstrucoesPagina('#passos-convulsao', this)" class="bg-[#2b2d42] hover:bg-[#1e2030] text-white border-none py-2.5 px-4 rounded-lg text-sm font-bold cursor-pointer transition-colors">
            🔊 Ouvir Instruções
          </button>
        </div>
      </div>
      <% } %>

      <div id="passos-<%= conteudo.id %>" class="flex flex-col gap-[22px] max-md:gap-4">
        <% conteudo.passos.forEach((passo) => { %>
        <div class="bg-white rounded-[12px] p-[18px] shadow-[0_4px_12px_rgba(0,0,0,0.08)] text-left flex gap-5 items-center max-md:flex-col max-md:items-center max-md:text-center max-md:gap-3 max-md:p-4">
          <img src="<%= passo.imagem %>" class="w-20 max-md:w-[90px] max-[480px]:w-[76px]" alt="<%= passo.alt %>">
          <div>
            <h3 class="text-[20px] font-bold mb-[6px]"><%= passo.titulo %></h3>
            <p class="text-[#444]"><%- passo.texto %></p>
          </div>
        </div>
        <% }); %>
      </div>

      <div class="mt-10 pt-6 border-t border-[#eee] flex flex-wrap justify-center gap-4">
        <a href="/#emergencias" class="bg-[#f5f5f5] hover:bg-[#eaeaea] text-[#222] font-bold py-3 px-6 rounded-lg no-underline text-sm transition-colors">
          ← Ver Outras Emergências
        </a>
        <a href="/rcp" class="bg-[#fff0f0] hover:bg-[#ffe0e0] text-[#d90429] font-bold py-3 px-6 rounded-lg no-underline text-sm transition-colors">
          ❤️ A vítima parou de respirar? Ir para RCP ›
        </a>
      </div>
    </section>

<%- include('partials/foot') %>
