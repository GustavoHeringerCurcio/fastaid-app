<%- include('partials/head', { titulo }) %>

<main class="pb-4">

  <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-[#777]" aria-label="Breadcrumb">
    <a href="/" class="font-medium text-[#777] no-underline transition-colors hover:text-brand-700">Início</a>
    <span aria-hidden="true">/</span>
    <a href="/#emergencias" class="font-medium text-[#777] no-underline transition-colors hover:text-brand-700">Emergências</a>
    <span aria-hidden="true">/</span>
    <span class="font-semibold text-ink"><%= conteudo.titulo %></span>
  </nav>

  <section class="overflow-hidden rounded-3xl border border-[#eee] bg-white p-8 text-center shadow-card max-md:p-6">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-brand-50 ring-1 ring-brand-100">
      <img src="<%= conteudo.icone %>" alt="<%= conteudo.titulo %>" class="h-12 w-12 object-contain">
    </div>

    <span class="mt-5 inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-brand-700">
      <%= conteudo.categoria %>
    </span>

    <h1 class="mt-3 text-[34px] font-extrabold leading-tight text-ink max-md:text-[27px]">
      <%= conteudo.titulo %>
    </h1>
    <p class="mx-auto mt-3 max-w-[520px] text-base leading-relaxed text-[#666]">
      Siga o passo a passo abaixo até a chegada do socorro.
    </p>
  </section>

  <% if (conteudo.alerta) { %>
  <div class="mt-6 flex flex-col gap-4 rounded-2xl border border-amber-200 bg-amber-50 p-5 sm:flex-row sm:items-center">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
      </svg>
    </div>
    <div class="flex-1">
      <p class="text-[11px] font-extrabold uppercase tracking-wider text-amber-700">
        Regra de ouro / O que NÃO fazer
      </p>
      <p class="mt-1 text-sm font-medium leading-relaxed text-[#4a3b1a]"><%= conteudo.alerta %></p>
    </div>
    <button
      type="button"
      onclick="lerInstrucoesPagina('#passos-<%= conteudo.id %>', this)"
      class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl border border-amber-200 bg-white px-4 py-2.5 text-sm font-bold text-[#4a3b1a] transition-colors hover:bg-amber-100"
    >
      🔊 Ouvir
    </button>
  </div>
  <% } %>

  <% if (conteudo.id === 'rcp') { %>
  <section class="mt-6 rounded-2xl border border-[#eee] bg-white p-5 shadow-card sm:p-6">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-3">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-xl">🥁</div>
        <div>
          <h2 class="text-base font-bold text-ink">Suporte de ritmo e voz</h2>
          <p class="mt-1 text-sm leading-relaxed text-[#666]">
            Comprima o centro do peito forte e rápido seguindo o bip sonoro.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          onclick="alternarMetronomoRCP(this)"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-600"
        >
          🥁 Iniciar Ritmo (110 BPM)
        </button>
        <button
          type="button"
          onclick="lerInstrucoesPagina('#passos-rcp', this)"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#ddd] bg-white px-4 py-2.5 text-sm font-bold text-[#444] transition-colors hover:border-brand-200 hover:text-brand-700"
        >
          🔊 Ouvir Instruções
        </button>
      </div>
    </div>
  </section>
  <% } %>

  <% if (conteudo.id === 'convulsao') { %>
  <section class="mt-6 rounded-2xl border border-[#eee] bg-white p-5 shadow-card sm:p-6">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-xl">⏱️</div>
        <div>
          <p class="text-[11px] font-extrabold uppercase tracking-wider text-[#777]">Tempo da crise</p>
          <div id="tempo-crise" class="font-mono text-3xl font-extrabold text-[#2b2d42]">00:00</div>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          id="btn-cronometro"
          onclick="alternarCronometroConvulsao(this, document.getElementById('tempo-crise'))"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-600"
        >
          ⏱️ Iniciar Cronômetro
        </button>
        <button
          type="button"
          onclick="zerarCronometroConvulsao(document.getElementById('btn-cronometro'), document.getElementById('tempo-crise'))"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#ddd] bg-white px-4 py-2.5 text-sm font-bold text-[#555] transition-colors hover:bg-[#f7f7f7]"
        >
          🔄 Zerar
        </button>
        <button
          type="button"
          onclick="lerInstrucoesPagina('#passos-convulsao', this)"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#ddd] bg-white px-4 py-2.5 text-sm font-bold text-[#444] transition-colors hover:border-brand-200 hover:text-brand-700"
        >
          🔊 Ouvir Instruções
        </button>
      </div>
    </div>
  </section>
  <% } %>

  <div class="mt-9 flex items-end justify-between gap-4">
    <h2 class="text-2xl font-bold text-ink">Passo a passo</h2>
    <span class="text-sm font-medium text-[#777]"><%= conteudo.passos.length %> passos</span>
  </div>

  <ol
    id="passos-<%= conteudo.id %>"
    class="relative mt-5 space-y-4 before:absolute before:bottom-6 before:left-[22px] before:top-6 before:w-px before:bg-[#e8e8e8]"
  >
    <% conteudo.passos.forEach((passo, index) => { %>
    <li class="relative flex gap-4 sm:gap-5">
      <div class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-500 text-sm font-extrabold text-white shadow-[0_6px_14px_rgba(255,77,77,0.28)]">
        <%= index + 1 %>
      </div>

      <div class="flex-1 rounded-2xl border border-[#eee] bg-white p-5 shadow-[0_2px_10px_rgba(0,0,0,0.03)]">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <% if (!conteudo.alerta) { %>
          <img
            src="<%= passo.imagem %>"
            alt="<%= passo.alt %>"
            class="h-20 w-20 shrink-0 rounded-xl object-contain"
          >
          <% } %>

          <div class="min-w-0">
            <h3 class="text-lg font-bold leading-snug text-ink"><%= passo.titulo %></h3>
            <p class="mt-2 leading-relaxed text-[#555]"><%- passo.texto %></p>
          </div>
        </div>
      </div>
    </li>
    <% }); %>
  </ol>

  <div class="mt-10 flex flex-col gap-3 border-t border-[#eee] pt-8 sm:flex-row sm:justify-center">
    <a
      href="/#emergencias"
      class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#eee] bg-white px-6 py-3 text-sm font-bold text-ink no-underline transition-colors hover:border-brand-200 hover:text-brand-700"
    >
      ← Ver outras emergências
    </a>

    <% if (conteudo.id !== 'rcp') { %>
    <a
      href="/rcp"
      class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-50 px-6 py-3 text-sm font-bold text-brand-700 no-underline transition-colors hover:bg-brand-100"
    >
      ❤️ Vítima parou de respirar? Ir para RCP →
    </a>
    <% } %>
  </div>

</main>

<%- include('partials/foot') %>
