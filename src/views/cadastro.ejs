<%- include('partials/auth-head', { titulo }) %>

<main class="grid min-h-screen lg:grid-cols-2">

  <%- include('partials/auth-brand') %>

  <section class="flex items-center justify-center px-5 py-10 sm:px-8 lg:min-h-screen">
    <div class="w-full max-w-[480px]">

      <div class="mb-8 flex items-center justify-center gap-2 lg:hidden">
        <img src="/images/logo.png" alt="Fast Aid" class="h-9 w-9 rounded-xl">
        <span class="text-lg font-extrabold tracking-tight text-ink">Fast Aid</span>
      </div>

      <a href="/" class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-[#555] no-underline transition-colors hover:text-brand-700">
        <span aria-hidden="true">←</span> Voltar ao site
      </a>

      <div class="rounded-3xl border border-[#eee] bg-white p-7 shadow-card sm:p-10">
        <div class="mb-7">
          <span class="inline-block rounded-full bg-brand-50 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-brand-700">
            Nova conta
          </span>
          <h1 class="mt-3 text-[28px] font-bold leading-tight text-ink">Crie sua conta</h1>
          <p class="mt-2 text-sm leading-relaxed text-[#666]">
            Leva menos de um minuto para começar.
          </p>
        </div>

        <form novalidate class="space-y-4">
          <div data-field>
            <label for="nome" class="mb-1.5 block text-sm font-medium text-[#333]">Nome completo</label>
            <div class="relative">
              <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#aaa]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              <input
                type="text"
                id="nome"
                required
                autocomplete="name"
                pattern="^[A-Za-zÀ-ÿ ]+$"
                placeholder="Digite seu nome"
                maxlength="50"
                class="w-full rounded-xl border border-[#ddd] bg-white py-3 pl-11 pr-4 text-[15px] text-ink outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/15"
              />
            </div>
            <span class="erro mt-1 block text-[13px] text-brand-700"></span>
          </div>

          <div data-field>
            <label for="email" class="mb-1.5 block text-sm font-medium text-[#333]">E-mail</label>
            <div class="relative">
              <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#aaa]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <input
                type="email"
                id="email"
                required
                autocomplete="email"
                placeholder="voce@email.com"
                maxlength="50"
                class="w-full rounded-xl border border-[#ddd] bg-white py-3 pl-11 pr-4 text-[15px] text-ink outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/15"
              />
            </div>
            <span class="erro mt-1 block text-[13px] text-brand-700"></span>
          </div>

          <div data-field>
            <label for="telefone" class="mb-1.5 block text-sm font-medium text-[#333]">Telefone</label>
            <div class="relative">
              <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#aaa]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <input
                type="tel"
                id="telefone"
                required
                autocomplete="tel"
                placeholder="(00) 00000-0000"
                maxlength="15"
                class="w-full rounded-xl border border-[#ddd] bg-white py-3 pl-11 pr-4 text-[15px] text-ink outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/15"
              />
            </div>
            <span class="erro mt-1 block text-[13px] text-brand-700"></span>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div data-field>
              <label for="senha" class="mb-1.5 block text-sm font-medium text-[#333]">Senha</label>
              <div class="relative">
                <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#aaa]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
                <input
                  type="password"
                  id="senha"
                  required
                  autocomplete="new-password"
                  placeholder="Mínimo 6 caracteres"
                  class="w-full rounded-xl border border-[#ddd] bg-white py-3 pl-11 pr-12 text-[15px] text-ink outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/15"
                />
                <button
                  type="button"
                  data-toggle-password
                  data-target="senha"
                  class="absolute right-3 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-lg text-[#888] transition-colors hover:bg-[#f5f5f5] hover:text-brand-700"
                  aria-label="Mostrar senha"
                  aria-pressed="false"
                >
                  <svg class="eye-open h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <svg class="eye-closed hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
                  </svg>
                </button>
              </div>
              <span class="erro mt-1 block text-[13px] text-brand-700"></span>
            </div>

            <div data-field>
              <label for="confirmarSenha" class="mb-1.5 block text-sm font-medium text-[#333]">Confirmar senha</label>
              <div class="relative">
                <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#aaa]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                <input
                  type="password"
                  id="confirmarSenha"
                  required
                  autocomplete="new-password"
                  placeholder="Repita a senha"
                  class="w-full rounded-xl border border-[#ddd] bg-white py-3 pl-11 pr-12 text-[15px] text-ink outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/15"
                />
                <button
                  type="button"
                  data-toggle-password
                  data-target="confirmarSenha"
                  class="absolute right-3 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-lg text-[#888] transition-colors hover:bg-[#f5f5f5] hover:text-brand-700"
                  aria-label="Mostrar senha"
                  aria-pressed="false"
                >
                  <svg class="eye-open h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  <svg class="eye-closed hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
                  </svg>
                </button>
              </div>
              <span class="erro mt-1 block text-[13px] text-brand-700"></span>
            </div>
          </div>

          <button
            type="submit"
            id="cadastroSubmit"
            class="w-full rounded-xl bg-brand-500 px-4 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-70"
          >
            Cadastrar
          </button>
        </form>

        <p class="mt-6 text-center text-sm text-[#666]">
          Já possui uma conta?
          <a href="/login" class="font-semibold text-brand-700 no-underline hover:underline">Entrar</a>
        </p>
      </div>

      <p class="mt-6 text-center text-xs text-[#999]">
        Em emergências, ligue <a href="tel:192" class="font-semibold text-brand-700 no-underline">192 (SAMU)</a>.
      </p>
    </div>
  </section>

</main>

<%- include('partials/auth-foot', { script: 'script.js' }) %>
