<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('tailwind-head') %>
  <title><%= titulo %></title>
</head>
<%
  const pathAtual = locals.currentPath || "";
  const linkBase = "relative text-base font-medium no-underline transition-colors hover:text-brand-700";
  const linkAtivo = "text-brand-700";
  const linkInativo = "text-[#444]";
%>
<body class="bg-[#fafafa] font-sans text-ink overflow-x-hidden scroll-smooth pb-24">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
    <header
      id="siteHeader"
      class="sticky top-0 z-40 -mx-4 border-b border-[#eee] bg-white/90 px-4 py-3 backdrop-blur-md transition-shadow duration-300 sm:-mx-6 sm:px-6"
    >
      <div class="flex items-center justify-between gap-4 max-md:flex-wrap">

        <div id="logohome" class="flex min-w-0 items-center gap-3">
          <a
            href="tel:192"
            class="group flex flex-col items-center no-underline transition-transform hover:scale-105 active:scale-95"
            title="Clique para ligar para o SAMU (192)"
          >
            <img
              src="/images/logo.png"
              alt="Ligar para o SAMU 192"
              class="h-10 w-10 rounded-xl shadow-sm max-[480px]:h-9 max-[480px]:w-9"
            >
            <span class="mt-1 text-[10px] font-extrabold uppercase tracking-tight text-brand-700 group-hover:underline">
              SAMU 192
            </span>
          </a>

          <a href="/" class="no-underline transition-opacity hover:opacity-80">
            <p class="text-[22px] font-extrabold tracking-tight text-ink max-md:text-[19px] max-[480px]:text-[18px]">
              Fast Aid
            </p>
          </a>
        </div>

        <nav id="main-nav" class="flex items-center gap-4 max-md:gap-2" aria-label="Menu principal">
          <a
            href="/"
            class="flex items-center gap-1.5 rounded-xl bg-[#f5f5f5] px-3 py-2 text-sm font-semibold text-ink no-underline transition-colors hover:bg-[#eee] hover:text-brand-700"
            title="Ir para a página inicial"
          >
            <svg class="h-4 w-4 shrink-0 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            <span>Início</span>
          </a>

          <div class="hidden items-center gap-5 md:flex">
            <a
              href="/aulas"
              class="<%= linkBase %> <%= pathAtual === '/aulas' ? linkAtivo : linkInativo %>"
              <%- pathAtual === '/aulas' ? 'aria-current="page"' : '' %>
            >
              Aulas
              <% if (pathAtual === '/aulas') { %>
              <span class="absolute -bottom-2 left-0 h-0.5 w-full rounded-full bg-brand-500"></span>
              <% } %>
            </a>
            <a
              href="/contato"
              class="<%= linkBase %> <%= pathAtual === '/contato' ? linkAtivo : linkInativo %>"
              <%- pathAtual === '/contato' ? 'aria-current="page"' : '' %>
            >
              Contato
              <% if (pathAtual === '/contato') { %>
              <span class="absolute -bottom-2 left-0 h-0.5 w-full rounded-full bg-brand-500"></span>
              <% } %>
            </a>
          </div>

          <div class="hidden items-center gap-3 md:flex">
            <a
              href="/cadastro"
              id="navCadastro"
              class="rounded-xl bg-brand-500 px-4 py-2 text-sm font-semibold text-white no-underline transition-colors hover:bg-brand-600"
            >
              Cadastrar-se
            </a>
            <a
              href="/login"
              id="navLogin"
              class="text-base font-medium text-[#444] no-underline transition-colors hover:text-brand-700"
            >
              Fazer login
            </a>
          </div>

          <div id="navProfile" class="hidden relative max-md:hidden">
            <button
              id="profileTrigger"
              class="flex cursor-pointer items-center gap-2 border-none bg-transparent p-0"
              aria-label="Abrir menu do perfil"
            >
              <img
                id="profilePic"
                src=""
                alt="Foto de perfil"
                class="h-9 w-9 rounded-full border-2 border-brand-500 object-cover transition-opacity hover:opacity-80"
              >
              <svg class="h-4 w-4 text-[#333]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div
              id="profileDropdown"
              class="absolute right-0 top-full mt-2 hidden w-60 rounded-2xl border border-[#eee] bg-white py-2 shadow-card"
            >
              <div id="profileEmail" class="border-b border-[#eee] px-4 py-3 text-sm text-[#555]"></div>
              <a href="/aulas" class="block px-4 py-2.5 text-sm font-medium text-ink no-underline transition-colors hover:bg-[#f7f7f7]">
                Minhas aulas
              </a>
              <button
                id="logoutBtn"
                class="flex w-full cursor-pointer items-center gap-2 border-none bg-transparent px-4 py-2.5 text-left text-sm font-medium text-brand-700 transition-colors hover:bg-brand-50"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                Sair
              </button>
            </div>
          </div>

          <button
            id="mobileMenuBtn"
            class="hidden flex-col gap-[5px] rounded-xl p-2 transition-colors hover:bg-[#f5f5f5] max-md:flex"
            aria-label="Abrir menu"
            aria-expanded="false"
            aria-controls="mobileMenu"
          >
            <span class="block h-[2.5px] w-6 rounded-full bg-[#333]"></span>
            <span class="block h-[2.5px] w-6 rounded-full bg-[#333]"></span>
            <span class="block h-[2.5px] w-6 rounded-full bg-[#333]"></span>
          </button>
        </nav>
      </div>
    </header>

    <div id="mobileMenu" class="pointer-events-none fixed inset-0 z-50" aria-hidden="true">
      <div id="mobileMenuBackdrop" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"></div>
      <div
        id="mobileMenuPanel"
        class="absolute right-0 top-0 h-full w-[300px] max-w-[85vw] translate-x-full bg-white p-6 pt-16 shadow-2xl transition-transform duration-300 ease-out"
      >
        <button
          id="mobileMenuClose"
          class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-xl bg-[#f5f5f5] text-[#333] transition-colors hover:bg-[#eee]"
          aria-label="Fechar menu"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <div class="flex flex-col gap-1">
          <a href="/" class="rounded-xl px-3 py-2.5 text-base font-bold text-ink no-underline transition-colors hover:bg-[#f7f7f7]">
            Início
          </a>
          <a
            href="/aulas"
            class="rounded-xl px-3 py-2.5 text-base no-underline transition-colors hover:bg-[#f7f7f7] <%= pathAtual === '/aulas' ? 'font-bold text-brand-700' : 'text-[#444]' %>"
          >
            Aulas
          </a>
          <a
            href="/contato"
            class="rounded-xl px-3 py-2.5 text-base no-underline transition-colors hover:bg-[#f7f7f7] <%= pathAtual === '/contato' ? 'font-bold text-brand-700' : 'text-[#444]' %>"
          >
            Contato
          </a>
        </div>

        <div class="mt-6 flex flex-col gap-2 border-t border-[#eee] pt-6">
          <a
            href="/cadastro"
            id="navCadastroMobile"
            class="rounded-xl bg-brand-500 px-4 py-3 text-center text-base font-semibold text-white no-underline transition-colors hover:bg-brand-600"
          >
            Cadastrar-se
          </a>
          <a
            href="/login"
            id="navLoginMobile"
            class="rounded-xl border border-[#eee] px-4 py-3 text-center text-base font-medium text-[#444] no-underline transition-colors hover:border-brand-200 hover:text-brand-700"
          >
            Fazer login
          </a>

          <div id="navProfileMobile" class="mt-4 hidden flex-col gap-3 border-t border-[#eee] pt-4">
            <div class="flex items-center gap-3 px-1">
              <img id="profilePicMobile" src="" alt="" class="h-10 w-10 rounded-full border-2 border-brand-500 object-cover">
              <span id="profileEmailMobile" class="truncate text-sm text-[#555]"></span>
            </div>
            <a href="/aulas" class="px-1 text-sm font-medium text-ink no-underline">Minhas aulas</a>
            <button
              id="logoutBtnMobile"
              class="flex w-full cursor-pointer items-center gap-2 rounded-xl border-none bg-transparent px-1 py-2 text-left text-sm font-medium text-brand-700 transition-colors hover:bg-brand-50"
            >
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
              Sair
            </button>
          </div>
        </div>
      </div>
    </div>
