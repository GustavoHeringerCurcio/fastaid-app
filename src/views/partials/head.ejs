<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= titulo %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-[Arial,sans-serif] text-[#222] overflow-x-hidden scroll-smooth pb-24">
  <div class="max-w-[1400px] mx-auto p-5 pt-0 max-lg:p-4 max-lg:pt-0 max-md:p-3 max-md:pt-0 max-[480px]:p-[10px] max-[480px]:pt-0">
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-[#eee] flex justify-between items-center py-3.5 gap-[18px] max-md:flex-row max-md:flex-wrap max-md:items-center max-md:justify-between max-md:py-[10px] max-md:gap-2">
      <div id="logohome" class="flex items-center gap-[12px] max-md:flex-[1_1_auto] max-md:min-w-0">
        <a href="tel:192" class="group flex flex-col items-center no-underline text-center transition-transform hover:scale-105 active:scale-95" title="Clique para ligar para o SAMU (192)">
          <img src="/images/logo.png" alt="Ligar para o SAMU 192" class="w-10 h-10 max-[480px]:w-[34px] max-[480px]:h-[34px] shadow-sm rounded-[8px]">
          <span class="text-[10px] font-extrabold text-[#ff4d4d] uppercase tracking-tighter leading-none mt-1 group-hover:underline">SAMU 192</span>
        </a>
        <a href="/" class="no-underline text-[#222] hover:opacity-80 transition-opacity">
          <p class="text-[22px] font-bold max-lg:text-[20px] max-md:text-[18px] max-[480px]:text-[17px]">Fast Aid</p>
        </a>
      </div>

      <nav id="main-nav" class="flex items-center gap-5 max-md:gap-2" aria-label="Menu principal">
        <a href="/" class="flex items-center gap-1.5 bg-[#f5f5f5] hover:bg-[#eaeaea] text-[#222] font-medium px-3 py-2 rounded-[8px] no-underline text-sm transition-colors" title="Ir para a página inicial">
          <svg class="w-4 h-4 text-[#ff4d4d] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <span>Início</span>
        </a>

        <div class="flex items-center gap-5 max-md:hidden">
          <a href="/aulas" class="no-underline text-[#333] hover:text-[#ff4d4d] transition-colors text-base">Aulas</a>
          <a href="/contato" class="no-underline text-[#333] hover:text-[#ff4d4d] transition-colors text-base">Contato</a>
          <a href="/cadastro" id="navCadastro" class="ml-auto bg-[#ff4d4d] hover:bg-[#e63e3e] text-white px-[14px] py-2 rounded-[8px] no-underline text-base transition-colors">Cadastrar-se</a>
          <a href="/login" id="navLogin" class="no-underline text-[#333] hover:text-[#ff4d4d] transition-colors text-base">Fazer login</a>
        </div>
        <div id="navProfile" class="hidden relative max-md:hidden">
          <button id="profileTrigger" class="flex items-center gap-2 cursor-pointer bg-transparent border-none p-0">
            <img id="profilePic" src="" alt="Foto de perfil" class="w-9 h-9 rounded-full object-cover border-2 border-[#ff4d4d] hover:opacity-80 transition-opacity">
            <svg class="w-4 h-4 text-[#333] transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="profileDropdown" class="hidden absolute right-0 top-full mt-2 w-56 bg-white rounded-[12px] shadow-[0_8px_24px_rgba(0,0,0,0.12)] border border-[#eee] py-2 z-50">
            <div class="px-4 py-2 text-sm text-[#555] border-b border-[#eee]" id="profileEmail"></div>
            <a href="/aulas" class="block px-4 py-2 text-sm text-[#333] no-underline hover:bg-[#f5f5f5] transition-colors">Minhas aulas</a>
            <button id="logoutBtn" class="w-full text-left px-4 py-2 text-sm text-[#ff4d4d] hover:bg-[#fff5f5] transition-colors flex items-center gap-2 cursor-pointer bg-transparent border-none">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
              Sair
            </button>
          </div>
        </div>
        <button id="mobileMenuBtn" class="hidden max-md:flex flex-col gap-[4px] p-1.5 bg-transparent border-none cursor-pointer" aria-label="Abrir menu">
          <span class="block w-6 h-[2.5px] bg-[#333] rounded-full"></span>
          <span class="block w-6 h-[2.5px] bg-[#333] rounded-full"></span>
          <span class="block w-6 h-[2.5px] bg-[#333] rounded-full"></span>
        </button>
      </nav>
    </header>

    <div id="mobileMenu" class="hidden fixed inset-0 z-50">
      <div id="mobileMenuBackdrop" class="absolute inset-0 bg-black/50"></div>
      <div class="absolute top-0 right-0 w-[280px] h-full bg-white shadow-lg p-6 pt-16">
        <button id="mobileMenuClose" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center bg-transparent border-none cursor-pointer">
          <svg class="w-6 h-6 text-[#333]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
        <div class="flex flex-col gap-4">
          <a href="/" class="no-underline text-[#333] font-bold text-base py-2 border-b border-[#eee]">Início</a>
          <a href="/aulas" class="no-underline text-[#333] text-base py-2 border-b border-[#eee]">Aulas</a>
          <a href="/contato" class="no-underline text-[#333] text-base py-2 border-b border-[#eee]">Contato</a>
          <a href="/cadastro" id="navCadastroMobile" class="bg-[#ff4d4d] text-white px-[14px] py-[10px] rounded-[8px] no-underline text-base text-center mt-2">Cadastrar-se</a>
          <a href="/login" id="navLoginMobile" class="no-underline text-[#333] text-base py-2 text-center">Fazer login</a>
          <div id="navProfileMobile" class="hidden flex-col gap-3 pt-4 mt-4 border-t border-[#eee]">
            <div class="flex items-center gap-3 px-1">
              <img id="profilePicMobile" src="" alt="" class="w-10 h-10 rounded-full object-cover border-2 border-[#ff4d4d]">
              <span id="profileEmailMobile" class="text-sm text-[#555] truncate"></span>
            </div>
            <a href="/aulas" class="text-sm text-[#333] no-underline px-1">Minhas aulas</a>
            <button id="logoutBtnMobile" class="w-full text-left px-3 py-2.5 text-sm text-[#ff4d4d] hover:bg-[#fff5f5] rounded-[8px] flex items-center gap-2 cursor-pointer bg-transparent border-none">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
              Sair
            </button>
          </div>
        </div>
      </div>
    </div>
