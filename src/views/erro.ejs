<%- include('partials/head', { titulo }) %>

    <section class="mx-auto flex max-w-[720px] flex-col items-center px-4 py-20 text-center max-md:py-12">
      <div class="mb-6 flex h-24 w-24 items-center justify-center rounded-3xl bg-brand-50 text-5xl ring-1 ring-brand-100">
        <svg class="h-11 w-11 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
        </svg>
      </div>

      <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-brand-700"><%= status %></p>
      <h1 class="mt-3 text-[38px] font-extrabold leading-tight text-ink max-md:text-[30px]">
        <%= tituloErro %>
      </h1>
      <p class="mt-4 max-w-[520px] text-lg leading-relaxed text-[#555] max-md:text-base">
        <%= mensagem %>
      </p>

      <div class="mt-8 flex w-full flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 px-6 py-3 text-base font-semibold text-white no-underline transition-colors hover:bg-brand-600">
          Voltar ao início
        </a>
        <a href="/#emergencias" class="inline-flex items-center justify-center rounded-xl border border-[#eee] bg-white px-6 py-3 text-base font-semibold text-ink no-underline transition-colors hover:border-brand-200 hover:text-brand-700">
          Ver emergências
        </a>
      </div>
    </section>

<%- include('partials/foot') %>
